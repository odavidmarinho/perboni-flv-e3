  "narrative": {
    "northStar": "Reposição com clareza",
    "overview": "Um aplicativo operacional de reposição: superfícies claras, verde de ação e informação organizada para leitura e conferência. O símbolo verdadeiro da Perboni permanece como referência de identidade; as cores da interface são derivadas da marca, sem constituir um manual oficial.\n\nArial é continuidade explícita do protótipo E2. A densidade moderada, as fotografias ilustrativas dos produtos e os campos grandes favorecem o trabalho de selecionar, contar e comparar quantidades.",
    "keyCharacteristics": [
      "Verde funcional sobre superfícies claras.",
      "Tipografia Arial herdada e números tabulares nas comparações.",
      "Bordas discretas e profundidade tonal, sem sombras.",
      "Conteúdo reorganizado para uso em celular."
    ],
    "rules": [
      {
        "name": "The Verde de ação Rule",
        "body": "O verde concentra ações, navegação corrente e indicação de disponibilidade; divergências usam vermelho e avisos usam tons quentes.",
        "section": "colors"
      },
      {
        "name": "The Continuidade Rule",
        "body": "A família Arial acompanha títulos, corpo e controles para manter a continuidade do protótipo E2.",
        "section": "typography"
      },
      {
        "name": "The Plano por padrão Rule",
        "body": "A separação entre superfícies usa fundo e borda; não acrescentar sombras decorativas às superfícies operacionais.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preservar o símbolo original e a identificação Perboni FLV.",
      "Do associar estados e divergências a texto explícito, além da cor.",
      "Do conservar o foco visível e a redução de movimento."
    ],
    "donts": [
      "Don't apresentar esta interface como manual oficial de marca.",
      "Don't substituir a Arial herdada por uma nova fonte de identidade.",
      "Don't usar fotografias ilustrativas como evidência de estoque real."
    ]
  }
